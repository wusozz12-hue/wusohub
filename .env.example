NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pexels API key for the homepage's licensed 100+ video feed.
# Get one from https://www.pexels.com/api/
PEXELS_API_KEY=

