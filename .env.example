# =====================================================================
# WusoHub - Environment variables
# Provide these values to connect your Supabase project.
# You ONLY need to fill in the two public values below.
# =====================================================================

# Your Supabase project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon/public key (Project Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional (auto-provided by v0 preview): redirect URL used for email
# confirmation callbacks. Leave empty for local development.
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
